{
  "manifest_version": 3,
  "name": "Заметки",
  "short_name": "Заметки",
  "version": "2.0.0",
  "description": "Локальные заметки: чек-листы, поиск, закрепление. В стиле One UI. Всё хранится только в браузере.",
  "minimum_chrome_version": "110",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Заметки",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
