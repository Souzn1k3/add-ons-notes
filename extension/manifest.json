{
  "manifest_version": 3,
  "name": "Notes Bridge (Samsung Notes)",
  "short_name": "Заметки",
  "version": "1.0.0",
  "description": "Заметки в стиле One UI с локальным мостом к Samsung Notes. Не аффилировано с Samsung Electronics.",
  "minimum_chrome_version": "110",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Заметки",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
